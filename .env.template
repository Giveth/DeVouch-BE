### PROJECT IMPORT
IMPORT_PROJECT_CRON_SCHEDULE=
AGORA_API_KEY=
# Giveth V6 core GraphQL endpoint. Giveth projects are imported ONLY from its
# `devouchProjectCatalog` query (#189) - there is no V5 fallback and no default.
# Leave this and both credentials unset to disable the Giveth source (reported
# as skipped, not failed); setting only some of the three is a configuration
# error. The old V5 default (mainnet.serve.giveth.io) is refused outright so the
# credentials are never sent to the public API. Point this only at an instance
# that exposes `devouchProjectCatalog`: not every V6 deployment does yet, and a
# missing query aborts the import with "Cannot query field" on the first page.
GIVETH_API_URL=
# HTTP Basic credentials for the catalog query (it enumerates unlisted projects,
# so it is authenticated). Required together with GIVETH_API_URL; the values are
# the DEVOUCH_USER / DEVOUCH_PASS configured in that instance's AdminJS global
# configuration. An unauthenticated request returns HTTP 200 with an
# UNAUTHENTICATED GraphQL error rather than a 401, so the importer surfaces it
# from the response body.
GIVETH_API_USERNAME=
GIVETH_API_PASSWORD=

### IPFS (optional)
IPFS_GATEWAY=

