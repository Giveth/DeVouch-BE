### PROJECT IMPORT
IMPORT_PROJECT_CRON_SCHEDULE=
AGORA_API_KEY=
GIVETH_API_URL=
# Set to "6" to import Giveth projects via the keyset-paginated
# `devouchProjectCatalog` query. Leave empty/unset for the legacy
# `allProjects` query (the default).
# NOT USABLE YET against the public Giveth API: `devouchProjectCatalog` is not
# exposed there, so setting this to "6" fails on the first page until the
# impact-graph release that adds the query is deployed. Keep unset here.
# Exception: compose.local.yaml sets it to "6" on purpose, because that stack
# points GIVETH_API_URL at an impact-graph running locally on :4000.
GIVETH_API_VERSION=
# HTTP Basic credentials for that instance's catalog query, which is
# authenticated. Only sent when BOTH are set, and only on the catalog query, so
# the legacy allProjects path never transmits them to the public API. An
# unauthenticated catalog request
# returns HTTP 200 with an UNAUTHENTICATED GraphQL error rather than a 401, so
# the importer surfaces it from the response body, not the status code.
GIVETH_API_USERNAME=
GIVETH_API_PASSWORD=

### IPFS (optional)
IPFS_GATEWAY=

