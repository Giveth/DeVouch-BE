{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // TypeScript 6 no longer auto-includes @types packages; list the ones
    // providing globals (node builtins and the jest test globals) explicitly.
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
